{
  "mcpServers": {
    "browser": {
      "command": "/usr/local/bin/bunx",
      "args": [
        "--cwd=/home/claude/app", "@playwright/mcp",
        "--headless",
        "--browser", "chromium",
        "--executable-path", "/usr/bin/chromium",
        "--no-sandbox"
      ],
      "env": {
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
      }
    }
  }
}

{
  "name": "joey-agent",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "dependencies": {
    "@devchitchat/chatopsjs": "^1.0.5",
    "@playwright/mcp": "latest"
  },
  "scripts": {
    "start": "bun src/index.js",
    "dev": "bun --hot src/index.js",
    "push": "infra push",
    "up": "infra up",
    "render": "infra render",
    "status": "infra status",
    "logs": "infra logs",

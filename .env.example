# devchitchat connection
DEVCHITCHAT_WS_URL=ws://localhost:3000/ws
DEVCHITCHAT_BOT_TOKEN=your-bot-token-here
DEVCHITCHAT_TLS_REJECT_UNAUTH=false

# Token for the Claude Code tester bot account (used by scripts/test-chat.js)
DEVCHITCHAT_CLAUDE_BOT_TOKEN=your-claude-tester-token-here

# Production WS URL — used by scripts/test-chat.js so it hits prod while
# DEVCHITCHAT_WS_URL still points to local for running the agent locally
DEVCHITCHAT_WS_URL_PROD=ws://your-prod-host/ws

# Local workspace — where repos are cloned into
# In the pod this is /workspace; locally point it anywhere
WORKSPACE=/Users/yourname/workspace

# mesh git server
MESH_URL=https://localhost:7979

# Absolute path to the claude binary (run: which claude)
# In the pod this is /home/claude/.bun/bin/claude
CLAUDE_BIN=/Users/yourname/.local/bin/claude
